PART H: MONGODB AGGREGATION PIPELINE
====================================

Q1. Display students with marks greater than 70.
db.students.aggregate([
  {$match: {marks: {$gt: 70}}}
])

Q2. Group students by course and count students.
db.students.aggregate([
  {$group: {_id: "$course", totalStudents: {$sum: 1}}}
])

Q3. Group students by city and count students.
db.students.aggregate([
  {$group: {_id: "$city", totalStudents: {$sum: 1}}}
])

Q4. Display departments having more than 2 students.
db.students.aggregate([
  {$group: {_id: "$department", totalStudents: {$sum: 1}}},
  {$match: {totalStudents: {$gt: 2}}}
])

Q5. Group students by department and display their names.
db.students.aggregate([
  {$group: {_id: "$department", studentNames: {$push: "$name"}}}
])

Q6. Group students by city and store complete student documents.
db.students.aggregate([
  {$group: {_id: "$city", students: {$push: "$$ROOT"}}}
])

Q7. Find students in the Computer department, then count them by city.
db.students.aggregate([
  {$match: {department: "Computer"}},
  {$group: {_id: "$city", totalStudents: {$sum: 1}}}
])

Q8. Group students by department, showing the count and complete records.
db.students.aggregate([
  {$group: {
    _id: "$department",
    totalStudents: {$sum: 1},
    students: {$push: "$$ROOT"}
  }}
])

Q9. Find students with marks greater than 75, group by department, and display names.
db.students.aggregate([
  {$match: {marks: {$gt: 75}}},
  {$group: {_id: "$department", studentNames: {$push: "$name"}}}
])

Q10. Group students by city, store complete records, and show cities with more than 3 students.
db.students.aggregate([
  {$group: {
    _id: "$city",
    totalStudents: {$sum: 1},
    students: {$push: "$$ROOT"}
  }},
  {$match: {totalStudents: {$gt: 3}}}
])


PART I: SHOPPING ORDERS DATABASE
================================

Use MongoDB shell.

1. Create/use database
use shoppingDB

2. Create collection
db.createCollection("orders")

3. Insert sample orders
db.orders.insertMany([
  {
    orderId: 1001,
    customerName: "Rahul Sharma",
    city: "Pune",
    products: [
      {productName: "Laptop", category: "Electronics", price: 65000, quantity: 1},
      {productName: "Mouse", category: "Electronics", price: 800, quantity: 2}
    ],
    couponDiscount: 1000,
    deliveryCharge: 100,
    totalAmount: 65700
  },
  {
    orderId: 1002,
    customerName: "Sneha Patil",
    city: "Mumbai",
    products: [
      {productName: "Mobile", category: "Electronics", price: 25000, quantity: 1},
      {productName: "Headphones", category: "Electronics", price: 2500, quantity: 1}
    ],
    couponDiscount: null,
    deliveryCharge: 0,
    totalAmount: 27500
  },
  {
    orderId: 1003,
    customerName: "Amit Joshi",
    city: "Pune",
    products: [
      {productName: "Shirt", category: "Fashion", price: 1500, quantity: 2},
      {productName: "Jeans", category: "Fashion", price: 2200, quantity: 1}
    ],
    couponDiscount: 500,
    deliveryCharge: 50,
    totalAmount: 4700
  }
])

Q1. Display each product as a separate document using $unwind.
db.orders.aggregate([
  {$unwind: "$products"}
])

Q2. Calculate total revenue for each product category.
db.orders.aggregate([
  {$unwind: "$products"},
  {$group: {
    _id: "$products.category",
    totalRevenue: {$sum: {$multiply: ["$products.price", "$products.quantity"]}}
  }}
])

Q3. Find the average order value for each city.
db.orders.aggregate([
  {$group: {_id: "$city", averageOrder: {$avg: "$totalAmount"}}}
])

Q4. Find the most expensive product price in each category.
db.orders.aggregate([
  {$unwind: "$products"},
  {$group: {_id: "$products.category", highestPrice: {$max: "$products.price"}}}
])

Q5. Find the cheapest product price in each category.
db.orders.aggregate([
  {$unwind: "$products"},
  {$group: {_id: "$products.category", lowestPrice: {$min: "$products.price"}}}
])

Q6. Display customer names and coupon discounts; show 0 when missing or null.
db.orders.aggregate([
  {$project: {
    _id: 0,
    customerName: 1,
    couponDiscount: {$ifNull: ["$couponDiscount", 0]}
  }}
])

Q7. Display products costing more than 20000 in each order.
db.orders.aggregate([
  {$project: {
    customerName: 1,
    expensiveProducts: {
      $filter: {
        input: "$products",
        as: "item",
        cond: {$gt: ["$$item.price", 20000]}
      }
    }
  }}
])

Q8. Display only Electronics products in each order.
db.orders.aggregate([
  {$project: {
    customerName: 1,
    electronics: {
      $filter: {
        input: "$products",
        as: "item",
        cond: {$eq: ["$$item.category", "Electronics"]}
      }
    }
  }}
])

Q9. Find the total quantity sold for each product.
db.orders.aggregate([
  {$unwind: "$products"},
  {$group: {_id: "$products.productName", quantitySold: {$sum: "$products.quantity"}}}
])

Q10. Group orders by city and display complete order details.
db.orders.aggregate([
  {$group: {_id: "$city", orders: {$push: "$$ROOT"}}}
])


